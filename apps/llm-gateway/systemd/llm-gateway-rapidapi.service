# LLM2API の RapidAPI 窓口(user unit)。
[Unit]
Description=LLM2API (RapidAPI, no x402) [user]
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/kojima/work/url2ai/apps/llm-gateway
ExecStart=/home/kojima/.local/node-v22.15.0/bin/node server-rapidapi.js
Restart=always
RestartSec=5
Environment=PORT=8018
Environment=OLLAMA_HOST=192.168.0.14
Environment=OLLAMA_PORT=11434
Environment=DEFAULT_MODEL=gemma4:12b-it-qat
# RAPIDAPI_PROXY_SECRET は root unit に直書きされていた。user unit では
# git管理外の .env.rapidapi から読む(unitファイルに秘密を書かない)。
EnvironmentFile=-/home/kojima/work/url2ai/apps/llm-gateway/.env.rapidapi

[Install]
WantedBy=default.target
